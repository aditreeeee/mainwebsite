@model CmsPage
@{ ViewData["Title"] = "New Page"; }
<div class="admin-toolbar">
    <h1>New Page</h1>
    <a class="admin-btn" href="/admin/pages">&larr; Back to Pages</a>
</div>
@if (!ViewData.ModelState.IsValid)
{
    <div class="admin-alert admin-alert--error">
        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@e.ErrorMessage</div>
        }
    </div>
}
<form method="post" action="/admin/pages/create">
    @Html.AntiForgeryToken()

    <div class="admin-card">
        <h2>Content</h2>
        <div class="admin-field"><label>Title</label><input asp-for="Title" id="pg-title" required /></div>
        <div class="admin-field">
            <label>Slug (URL)</label>
            <input asp-for="Slug" id="pg-slug" placeholder="e.g. franchise-opportunities" required />
            <p class="admin-hint" style="margin-top:6px;">Page will be live at /<span id="pg-slug-preview">your-slug</span>.html</p>
        </div>
        <div class="admin-field"><label>Subtitle (optional, shown under the title)</label><input asp-for="Subtitle" /></div>
        <div class="admin-checkbox-row"><input asp-for="UseCustomHero" type="checkbox" id="pg-custom-hero" /> <label asp-for="UseCustomHero">Custom hero (advanced: Body must include its own full &lt;header&gt; hero and final CTA section, Title/Subtitle above and the generic hero/CTA are skipped)</label></div>
        <div class="admin-field">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <label style="margin-bottom:0;">Body (HTML)</label>
                <button type="button" class="admin-btn" id="pg-preview-toggle">Preview</button>
            </div>
            <textarea asp-for="Body" id="pg-body" rows="18" style="font-family:monospace; font-size:12.5px; margin-top:8px;" required></textarea>
            <iframe id="pg-preview" title="Body preview" style="display:none; width:100%; border:1px solid #D8DBE0; border-radius:6px; margin-top:8px;"></iframe>
        </div>
    </div>

    <div class="admin-card">
        <h2>Publishing</h2>
        <div class="admin-field"><label>Sort Order</label><input asp-for="SortOrder" type="number" style="max-width:120px;" /></div>
        <div class="admin-checkbox-row"><input asp-for="IsPublished" type="checkbox" checked /> <label asp-for="IsPublished">Published</label></div>
    </div>

    <div class="admin-card">
        <h2>SEO</h2>
        <p class="admin-hint">Falls back to Title/Subtitle if left blank. Drives the &lt;title&gt;, meta description, and Open Graph/Twitter tags.</p>
        <div class="admin-field"><label>Meta Title</label><input asp-for="MetaTitle" /></div>
        <div class="admin-field"><label>Meta Description</label><input asp-for="MetaDescription" /></div>
        <div class="admin-field"><label>Meta Keywords</label><input asp-for="MetaKeywords" /></div>
    </div>

    <button class="admin-btn admin-btn--primary admin-btn--save-bar" type="submit">Create Page</button>
</form>

<script>
(function () {
    "use strict";
    var titleEl = document.getElementById("pg-title");
    var slugEl = document.getElementById("pg-slug");
    var slugPreview = document.getElementById("pg-slug-preview");
    var slugTouched = false;

    function slugify(text) {
        return text.trim().toLowerCase()
            .replace(/[^a-z0-9\s-]/g, "")
            .replace(/\s+/g, "-")
            .replace(/-+/g, "-");
    }

    slugEl.addEventListener("input", function () {
        slugTouched = true;
        slugPreview.textContent = slugEl.value || "your-slug";
    });
    titleEl.addEventListener("input", function () {
        if (slugTouched && slugEl.value) return;
        slugEl.value = slugify(titleEl.value);
        slugPreview.textContent = slugEl.value || "your-slug";
    });

    var bodyEl = document.getElementById("pg-body");
    var previewEl = document.getElementById("pg-preview");
    var toggleBtn = document.getElementById("pg-preview-toggle");
    var customHeroEl = document.getElementById("pg-custom-hero");

    // See Pages/Edit.cshtml for why this is an iframe with the real site
    // stylesheet linked rather than raw HTML in a plain admin-styled div,
    // .page-hero/.sol-section/etc. only look right under style.min.css.
    function buildPreviewDoc(bodyHtml) {
        var wrapped = customHeroEl.checked
            ? bodyHtml
            : '<section class="section-tight panel-white"><div class="container" style="max-width:900px;"><div class="article-content">' + bodyHtml + '</div></div></section>';
        return '<!DOCTYPE html><html><head><meta charset="utf-8">' +
            '<link rel="stylesheet" href="/css/style.min.css">' +
            '<style>body{margin:0;}</style></head><body>' + wrapped + '</body></html>';
    }

    toggleBtn.addEventListener("click", function () {
        var showing = previewEl.style.display !== "none";
        if (showing) {
            previewEl.style.display = "none";
            bodyEl.style.display = "block";
            toggleBtn.textContent = "Preview";
        } else {
            var html = bodyEl.value || '<p style="padding:20px;color:#6B7280;">Nothing to preview yet.</p>';
            previewEl.srcdoc = buildPreviewDoc(html);
            previewEl.style.display = "block";
            previewEl.style.height = "70vh";
            bodyEl.style.display = "none";
            toggleBtn.textContent = "Edit HTML";
        }
    });
})();
</script>
