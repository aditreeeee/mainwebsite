@model ContentBlock
@{ ViewData["Title"] = "Edit Content Block"; }
<h1>Edit Content Block</h1>
<div class="admin-card">
    <form method="post" action="/admin/content/@Model.Id/edit">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="admin-field"><label>Page</label>
            <select asp-for="PageKey"><option value="home">Home</option><option value="reseller">Resellers</option></select>
        </div>
        <div class="admin-field"><label>Section Key</label><input asp-for="SectionKey" required /></div>
        <div class="admin-field"><label>Kicker</label><input asp-for="Kicker" /></div>
        <div class="admin-field"><label>Title</label><input asp-for="Title" /></div>
        <div class="admin-field"><label>Subtitle</label><input asp-for="Subtitle" /></div>
        <div class="admin-field"><label>Body</label><textarea asp-for="Body" rows="4"></textarea></div>
        <div class="admin-field"><label>CTA Label</label><input asp-for="CtaLabel" /></div>
        <div class="admin-field"><label>CTA URL</label><input asp-for="CtaUrl" /></div>
        <div class="admin-field"><label>Image URL</label><input asp-for="ImageUrl" /></div>
        <div class="admin-field"><label>Sort Order</label><input asp-for="SortOrder" type="number" /></div>
        <div class="admin-checkbox-row"><input asp-for="IsPublished" type="checkbox" /> <label asp-for="IsPublished">Published</label></div>
        <button class="admin-btn admin-btn--primary" type="submit">Save</button>
        <a class="admin-btn admin-btn--ghost" href="/admin/content?page=@Model.PageKey">Cancel</a>
    </form>
</div>
