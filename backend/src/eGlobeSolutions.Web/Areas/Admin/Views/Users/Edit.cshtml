@using eGlobeSolutions.Web.Areas.Admin.Models
@model EditUserModel
@{ ViewData["Title"] = "Edit User"; }
<h1>Edit User</h1>
<div class="admin-card">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="admin-alert admin-alert--error">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }
    <form method="post" action="/admin/users/@Model.Id/edit">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="admin-field"><label>Email</label><input value="@Model.Email" disabled /></div>
        <div class="admin-field"><label>Full Name</label><input asp-for="FullName" required /></div>
        <div class="admin-checkbox-row"><input asp-for="IsActive" type="checkbox" /> <label asp-for="IsActive">Active</label></div>
        <div class="admin-field">
            <label>Role</label>
            <select asp-for="Role" required>
                @foreach (var r in Model.AvailableRoles)
                {
                    <option value="@r">@r</option>
                }
            </select>
        </div>
        <div class="admin-field"><label>New Password (leave blank to keep current)</label><input asp-for="NewPassword" type="password" /></div>
        <button class="admin-btn admin-btn--primary" type="submit">Save</button>
        <a class="admin-btn admin-btn--ghost" href="/admin/users">Cancel</a>
    </form>
</div>
