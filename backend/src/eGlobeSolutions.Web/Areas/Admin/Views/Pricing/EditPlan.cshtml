@model PricingPlan
@{ ViewData["Title"] = "Edit Pricing Plan"; }
<h1>Edit Pricing Plan</h1>
<div class="admin-card">
    <form method="post" action="/admin/pricing/plan/@Model.Id/edit">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="admin-field"><label>Name</label><input asp-for="Name" /></div>
        <div class="admin-field"><label>Badge Text</label><input asp-for="BadgeText" /></div>
        <div class="admin-field"><label>Unit Description</label><textarea asp-for="UnitDescription" rows="2"></textarea></div>
        <div class="admin-checkbox-row"><input asp-for="IsFeatured" type="checkbox" /> <label asp-for="IsFeatured">Featured plan</label></div>
        <div class="admin-checkbox-row"><input asp-for="IsPublished" type="checkbox" /> <label asp-for="IsPublished">Published</label></div>
        <div class="admin-field"><label>CTA Label</label><input asp-for="CtaLabel" /></div>
        <div class="admin-field"><label>CTA URL</label><input asp-for="CtaUrl" /></div>
        <div class="admin-field"><label>Sort Order</label><input asp-for="SortOrder" type="number" /></div>
        <button class="admin-btn admin-btn--primary" type="submit">Save</button>
        <a class="admin-btn admin-btn--ghost" href="/admin/pricing">Back</a>
    </form>
</div>

<div class="admin-card">
    <h3>Features</h3>
    <table class="admin-table">
        <tbody>
        @foreach (var f in Model.Features)
        {
            <tr>
                <td>@f.Text</td>
                <td style="width:90px;">
                    <form method="post" action="/admin/pricing/feature/@f.Id/delete" onsubmit="return confirm('Remove this feature?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="planId" value="@Model.Id" />
                        <button class="admin-btn admin-btn--danger" type="submit">Remove</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <form method="post" action="/admin/pricing/plan/@Model.Id/feature/add" style="display:flex; gap:8px; margin-top:12px;">
        @Html.AntiForgeryToken()
        <input type="text" name="text" placeholder="New feature bullet…" style="flex:1; padding:9px 12px; border:1px solid var(--border); border-radius:6px;" required />
        <button class="admin-btn admin-btn--primary" type="submit">Add</button>
    </form>
</div>
