@model BlogIndexViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@(Model.Seo?.Title ?? "Blog, eGlobe Solutions | Hotel Technology Guides & Updates")</title>
<meta name="description" content="@(Model.Seo?.Description ?? "Guides, product updates and industry news on hotel technology from the eGlobe Solutions team.")">
<meta name="keywords" content="@(Model.Seo?.Keywords ?? "hotel technology blog")">
<link rel="canonical" href="@(Model.Seo?.CanonicalUrl ?? "https://www.eglobe-solutions.com/blog.html")">
<meta property="og:type" content="website">
<meta property="og:title" content="@(Model.Seo?.Title ?? "Blog, eGlobe Solutions")">
<meta property="og:description" content="@(Model.Seo?.Description ?? "Guides, product updates and industry news on hotel technology from the eGlobe Solutions team.")">
<meta property="og:url" content="@(Model.Seo?.CanonicalUrl ?? "https://www.eglobe-solutions.com/blog.html")">
<meta property="og:image" content="@(Model.Seo?.OgImageUrl ?? "https://www.eglobe-solutions.com/img/eGlobe-Solutions-hotel-management-services.png")">
<meta property="og:image:alt" content="eGlobe Solutions connected hotel management ecosystem">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="@(Model.Seo?.Title ?? "Blog, eGlobe Solutions")">
<meta name="twitter:description" content="@(Model.Seo?.Description ?? "Guides, product updates and industry news on hotel technology from the eGlobe Solutions team.")">
<meta name="twitter:image" content="@(Model.Seo?.OgImageUrl ?? "https://www.eglobe-solutions.com/img/eGlobe-Solutions-hotel-management-services.png")">
<link rel="stylesheet" href="~/css/style.css">
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Blog",
  "name": "eGlobe Solutions Blog",
  "description": "Guides, product updates and industry news on hotel channel managers, PMS, OTA distribution and revenue management.",
  "url": "https://www.eglobe-solutions.com/blog.html"
}
</script>
</head>
<body>

<div class="scroll-progress"></div>

<div class="topbar">
  <div class="topbar__inner">
    <a href="index.html" class="brand"><img class="mark" src="https://www.eglobe-solutions.com/img/logo-dark.webp" alt="eGlobe Solutions"></a>
    @await Component.InvokeAsync("TopNav")
    <div class="topbar__actions">
      <a href="https://www.eglobe-solutions.com/hms" target="_blank" rel="noopener" class="btn btn-ghost btn-sm">Log In</a>
      <a href="contact.html" class="btn btn-primary btn-sm">Talk to Sales</a>
    </div>
    <button class="topbar__burger" id="topbar-burger" aria-label="Toggle menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line class="l1" x1="3" y1="6" x2="21" y2="6"/><line class="l2" x1="3" y1="12" x2="21" y2="12"/><line class="l3" x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</div>

<header class="page-hero page-hero--compact">
  <div class="container page-hero__split">
    <h1 data-reveal><span class="accent">Blog</span> &amp; <span class="accent-alt">Updates</span></h1>
    <p class="lead" data-reveal>Guides, product news and industry insight for hoteliers, straight from the eGlobe team.</p>
  </div>
</header>

@if (Model.Featured is not null)
{
  <!-- ===================== FEATURED POST ===================== -->
  <section class="section panel-white">
    <div class="container">
      <div class="blog-featured" data-reveal="scale">
        <div class="ph blog-featured__img"><span class="ph__label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>Featured image</span></div>
        <div class="blog-featured__body">
          <div class="blog-meta">
            <span class="blog-meta__tag">@Model.Featured.Category</span>
            <span>@Model.Featured.PublishedAtUtc.ToString("MMM d, yyyy")</span>
            <span>@Model.Featured.ReadTimeMinutes min read</span>
          </div>
          <h2>@Model.Featured.Title</h2>
          <p>@Model.Featured.Excerpt</p>
          <div class="blog-author">
            <div class="blog-author__avatar">@(new string(Model.Featured.AuthorName.Split(' ').Where(w => w.Length > 0).Select(w => w[0]).Take(2).ToArray()))</div>
            <div><div class="blog-author__name">@Model.Featured.AuthorName</div><div class="blog-author__role">@Model.Featured.AuthorRole</div></div>
          </div>
          @if (!string.IsNullOrWhiteSpace(Model.Featured.Slug) && !string.IsNullOrWhiteSpace(Model.Featured.Body))
          {
            <a href="@(Model.Featured.Slug).html" class="blog-read-link">Read article <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
          }
        </div>
      </div>
    </div>
  </section>
}

<!-- ===================== FILTERS + GRID ===================== -->
<section class="section section-border-top panel-white">
  <div class="container">
    <div class="blog-filters" data-reveal>
      <button type="button" class="blog-filter active" data-filter="all">All</button>
      <button type="button" class="blog-filter" data-filter="guide">Guides</button>
      <button type="button" class="blog-filter" data-filter="product">Product Updates</button>
      <button type="button" class="blog-filter" data-filter="news">Industry News</button>
    </div>

    <div class="blog-grid" data-reveal-group>
      @foreach (var post in Model.Posts)
      {
        var hasArticle = !string.IsNullOrWhiteSpace(post.Slug) && !string.IsNullOrWhiteSpace(post.Body);
        var href = hasArticle ? $"{post.Slug}.html" : "#";
        var categoryFilter = post.Category.ToLowerInvariant() switch { "product" => "product", "news" => "news", _ => "guide" };
        <a href="@href" class="blog-card" data-category="@categoryFilter">
          <div class="ph blog-card__img"><span class="ph__label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>@post.Category</span></div>
          <div class="blog-meta"><span class="blog-meta__tag">@post.Category</span><span>@post.PublishedAtUtc.ToString("MMM d, yyyy")</span><span>@post.ReadTimeMinutes min read</span></div>
          <h3>@post.Title</h3>
          <p>@post.Excerpt</p>
        </a>
      }
    </div>
  </div>
</section>

@await Component.InvokeAsync("SiteFooter")

<div class="nav-dock-wrap">
  <nav class="nav-dock">
    <button class="nav-dock__burger" id="nav-dock-burger" aria-label="Toggle menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line class="l1" x1="3" y1="6" x2="21" y2="6"/><line class="l2" x1="3" y1="12" x2="21" y2="12"/><line class="l3" x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <span class="nav-dock__brand"><img src="https://www.eglobe-solutions.com/img/logo-dark.webp" alt="eGlobe"></span>
    @await Component.InvokeAsync("NavDock")
    <a href="contact.html" class="nav-dock__cta">Book a Demo</a>
  </nav>
</div>

<script src="~/js/main.js"></script>
</body>
</html>
