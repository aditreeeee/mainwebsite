@model ContentPageViewModel
@{
    Layout = null;
    var hero = Model.Block("hero");
    var sidebarBenefits = Model.Block("sidebar-benefits");

    static IEnumerable<string> Bullets(eGlobeSolutions.Domain.Entities.ContentBlock? b) =>
        (b?.Body ?? string.Empty).Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    var phone = Model.Setting(SiteSettingKeys.Phone, "+91 9818880480");
    var email = Model.Setting(SiteSettingKeys.Email, "support@eglobe-solutions.com");
    var whatsApp = Model.Setting(SiteSettingKeys.WhatsAppNumber, "919818880480");
    var callUsRaw = Model.Setting(SiteSettingKeys.CallUsNumbers, "+91 11 41717081/ +91 11 41717082/ +91 11 41717021");
    var callUsNumbers = callUsRaw.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var hours = Model.Setting(SiteSettingKeys.BusinessHours, "Monday - Saturday, 9:30 AM - 6:30 PM (IST)");
    var facebook = Model.Setting(SiteSettingKeys.FacebookUrl, "https://www.facebook.com/eglobesolution");
    var youtube = Model.Setting(SiteSettingKeys.YoutubeUrl, "https://www.youtube.com/@eglobesolutionspms");
    var linkedIn = Model.Setting(SiteSettingKeys.LinkedInUrl, "https://www.linkedin.com/company/eglobesolutions/");
    var phoneDigits = new string(phone.Where(char.IsDigit).ToArray());
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/png" href="~/assets/logo.png">
<title>@(Model.Seo?.Title ?? "Contact Sales, eGlobe Solutions | Hotel Management Software Demo")</title>
<meta name="description" content="@(Model.Seo?.Description ?? "Talk to eGlobe's sales team about the hotel technology stack we source and connect for you.")">
<meta name="keywords" content="@(Model.Seo?.Keywords ?? "hotel management software demo, hotel PMS demo")">
<link rel="canonical" href="@(Model.Seo?.CanonicalUrl ?? "https://www.eglobe-solutions.com/contact.html")">
<meta property="og:type" content="website">
<meta property="og:title" content="@(Model.Seo?.Title ?? "Contact Sales, eGlobe Solutions")">
<meta property="og:description" content="@(Model.Seo?.Description ?? "Talk to our sales team about the hotel technology stack eGlobe sources for you.")">
<meta property="og:url" content="@(Model.Seo?.CanonicalUrl ?? "https://www.eglobe-solutions.com/contact.html")">
<meta property="og:image" content="@(Model.Seo?.OgImageUrl ?? "https://www.eglobe-solutions.com/img/eGlobe-Solutions-hotel-management-services.png")">
<meta property="og:image:alt" content="eGlobe Solutions connected hotel management ecosystem">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="@(Model.Seo?.Title ?? "Contact Sales, eGlobe Solutions")">
<meta name="twitter:description" content="@(Model.Seo?.Description ?? "Talk to our sales team about the hotel technology stack eGlobe sources for you.")">
<meta name="twitter:image" content="@(Model.Seo?.OgImageUrl ?? "https://www.eglobe-solutions.com/img/eGlobe-Solutions-hotel-management-services.png")">
<link rel="stylesheet" href="~/css/style.min.css">
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "Organization",
      "@@id": "https://www.eglobe-solutions.com/#organization",
      "name": "eGlobe Solutions",
      "url": "https://www.eglobe-solutions.com/",
      "logo": "https://www.eglobe-solutions.com/img/logo-dark.webp",
      "sameAs": [
        "https://www.facebook.com/eglobesolution",
        "https://www.youtube.com/@@eglobesolutionspms",
        "https://www.linkedin.com/company/eglobesolutions/"
      ],
      "contactPoint": {
        "@@type": "ContactPoint",
        "telephone": "+91-9818880480",
        "contactType": "sales",
        "email": "support@@eglobe-solutions.com",
        "areaServed": "IN",
        "availableLanguage": ["English", "Hindi"]
      }
    },
    {
      "@@type": "WebSite",
      "@@id": "https://www.eglobe-solutions.com/#website",
      "url": "https://www.eglobe-solutions.com/",
      "name": "eGlobe Solutions",
      "publisher": { "@@id": "https://www.eglobe-solutions.com/#organization" }
    }
  ]
}
</script>
</head>
<body>

<div class="scroll-progress"></div>

<div class="topbar">
  <div class="topbar__inner">
    <a href="index.html" class="brand"><img class="mark" src="https://www.eglobe-solutions.com/img/logo-dark.webp" alt="eGlobe Solutions"></a>
    @await Component.InvokeAsync("TopNav")
    <div class="topbar__actions">
      <a href="https://www.eglobe-solutions.com/hms" target="_blank" rel="noopener" class="btn btn-ghost btn-sm">Log In</a>
      <a href="contact.html" class="btn btn-primary btn-sm">Talk to Sales</a>
    </div>
    <button class="topbar__burger" id="topbar-burger" aria-label="Toggle menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line class="l1" x1="3" y1="6" x2="21" y2="6"/><line class="l2" x1="3" y1="12" x2="21" y2="12"/><line class="l3" x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</div>

<header class="page-hero page-hero--compact">
  <div class="container page-hero__split">
    <h1 data-reveal>@Html.Raw(hero?.Title ?? "<span class=\"accent\">Let's Source</span> the <span class=\"accent-alt\">Right Stack</span> for Your Hotel.")</h1>
    <p class="lead" data-reveal>@(hero?.Subtitle ?? "Tell us about your property and we'll walk you through the tools that fit, no pressure, no obligation.")</p>
  </div>
</header>

<!-- ===================== FORM + PRODUCT INFO ===================== -->
<section class="section panel-white">
  <div class="container">
    <div class="sales-layout">

      <!-- FORM -->
      <form id="sales-form" class="sales-form" data-reveal="left" novalidate method="post" action="/contact/submit">
        @Html.AntiForgeryToken()
        <div class="sales-form__head">
          <h2 class="sales-form__title">Tell Us About Your Property</h2>
          <span class="sales-form__progress" id="sales-form-progress">0 of 5</span>
        </div>
        <div class="sales-form__bar"><span id="sales-form-bar-fill"></span></div>

        <input type="text" name="website" id="sales-form-website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" aria-hidden="true">

        <div class="sales-form__grid">
          <div class="field" data-field="name">
            <label class="mono">Full Name *</label>
            <input type="text" required autocomplete="name">
            <span class="field-msg"></span>
          </div>
          <div class="field" data-field="company">
            <label class="mono">Hotel Name *</label>
            <input type="text" required autocomplete="organization">
            <span class="field-msg"></span>
          </div>
          <div class="field" data-field="email">
            <label class="mono">Work Email *</label>
            <input type="email" required autocomplete="email">
            <span class="field-msg"></span>
          </div>
          <div class="field" data-field="phone">
            <label class="mono">Phone *</label>
            <input type="tel" required autocomplete="tel">
            <span class="field-msg"></span>
          </div>
        </div>

        <div class="field" data-field="rooms">
          <label class="mono">Number of Rooms *</label>
          <div class="room-chips" role="group" aria-label="Number of rooms">
            <button type="button" class="room-chip" data-rooms="1-10">1–10</button>
            <button type="button" class="room-chip" data-rooms="11-50">11–50</button>
            <button type="button" class="room-chip" data-rooms="51-150">51–150</button>
            <button type="button" class="room-chip" data-rooms="150+">150+</button>
          </div>
          <input type="hidden" required>
          <p class="field-hint" id="rooms-hint">Pick a range, we'll suggest the right plan.</p>
        </div>

        <div class="field">
          <label class="mono">Interested In <span class="field-optional">(pick any)</span></label>
          <div class="product-chips">
            <button type="button" class="product-chip" data-product="Demo Call">Demo Call</button>
            <button type="button" class="product-chip" data-product="Free Trial">Free Trial</button>
            <button type="button" class="product-chip" data-product="Cloud PMS">Cloud PMS</button>
            <button type="button" class="product-chip" data-product="Channel Manager">Channel Manager</button>
            <button type="button" class="product-chip" data-product="Cloud POS">Cloud POS</button>
            <button type="button" class="product-chip" data-product="Booking Engine">Booking Engine</button>
            <button type="button" class="product-chip" data-product="eGlobe AI Tools">eGlobe AI Tools</button>
            <button type="button" class="product-chip" data-product="Reseller / Partnership">Reseller / Partnership</button>
            <button type="button" class="product-chip" data-product="Not sure yet">Not sure yet</button>
            <button type="button" class="product-chip" id="product-chip-other" data-product="Others">Others</button>
          </div>
          <input type="text" id="product-other-input" class="product-other-input" placeholder="Tell us what you're looking for…">
        </div>

        <div class="field sales-form__message">
          <label class="mono">Message <span class="field-optional">(optional)</span></label>
          <textarea id="sales-form-message" rows="3" placeholder="Anything specific we should know?"></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-block sales-form__submit">Send</button>
        <p class="form-status"></p>
      </form>

      <!-- PRODUCT INFO SIDEBAR -->
      <div class="sales-sidebar" data-reveal="right">
        <h2 class="sales-sidebar__title">What happens next</h2>
        <div class="why-list">
          @{ var icons = new[]
             {
               "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><polyline points=\"12 7 12 12 16 14\"/></svg>",
               "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/></svg>",
               "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 3v18h18M7 15l4-4 3 3 5-6\"/></svg>"
             };
             var bullets = Bullets(sidebarBenefits).ToList();
             if (bullets.Count == 0) bullets = new List<string> { "Reply within 1 business day", "Walkthrough of modules that fit you", "Clear pricing, no hidden costs" };
          }
          @for (var i = 0; i < bullets.Count; i++)
          {
            <div class="why-item">@Html.Raw(icons[i % icons.Length])@bullets[i]</div>
          }
        </div>
        <div class="stat-card light">
          <div class="lbl">Recommended plan</div>
          <div id="sales-plan-suggestion" class="sales-plan-suggestion">Tell us your room count</div>
        </div>
        <div class="get-in-touch">
          <h3>Get In Touch</h3>
          <a href="tel:+@phoneDigits"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>@phone</a>
          @if (callUsNumbers.Length > 0)
          {
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>Call Us:
              @for (var i = 0; i < callUsNumbers.Length; i++)
              {
                <a href="tel:+@(new string(callUsNumbers[i].Where(char.IsDigit).ToArray()))">@callUsNumbers[i]</a>
                if (i < callUsNumbers.Length - 1)
                {
                  @:/
                }
              }
            </span>
          }
          <a href="mailto:@email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6l-10 7L2 6"/></svg>@email</a>
          <a href="https://www.eglobe-solutions.com" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15 15 0 014 10 15 15 0 01-4 10 15 15 0 01-4-10 15 15 0 014-10z"/></svg>www.eglobe-solutions.com</a>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>@hours</span>
          <div class="get-in-touch__social">
            <a href="@facebook" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg></a>
            <a href="@youtube" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M23 12s0-3.6-.46-5.3a3 3 0 00-2.1-2.1C18.7 4 12 4 12 4s-6.7 0-8.44.6a3 3 0 00-2.1 2.1C1 8.4 1 12 1 12s0 3.6.46 5.3a3 3 0 002.1 2.1C5.3 20 12 20 12 20s6.7 0 8.44-.6a3 3 0 002.1-2.1C23 15.6 23 12 23 12z"/><polygon points="9.75 8.5 16 12 9.75 15.5" fill="#fff"/></svg></a>
            <a href="@linkedIn" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
            <a href="https://wa.me/@whatsApp" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

@await Component.InvokeAsync("SiteFooter")

<div class="nav-dock-wrap">
  <nav class="nav-dock">
    <button class="nav-dock__burger" id="nav-dock-burger" aria-label="Toggle menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line class="l1" x1="3" y1="6" x2="21" y2="6"/><line class="l2" x1="3" y1="12" x2="21" y2="12"/><line class="l3" x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <span class="nav-dock__brand"><img src="/assets/logo.png" alt="eGlobe"></span>
    @await Component.InvokeAsync("NavDock")
    <a href="contact.html" class="nav-dock__cta">Book a Demo</a>
  </nav>
</div>

<script src="~/js/main.min.js"></script>
</body>
</html>
