@model List<FaqItem>
@if (Model.Count > 0)
{
  <section class="sol-section">
    <div class="container" style="max-width:800px;">
      <div class="sol-section-head" style="margin:0 auto 28px; text-align:center; max-width:100%;">
        <span class="section-kicker">FAQ</span>
        <h2 data-reveal>Frequently Asked Questions</h2>
      </div>
      <div class="faq-list" data-reveal-group>
        @foreach (var faq in Model)
        {
          <div class="faq-item">
            <div class="faq-q"><span>@faq.Question</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
            <div class="faq-a"><p>@faq.Answer</p></div>
          </div>
        }
      </div>
    </div>
  </section>
}
