@model PricingPageViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/png" href="~/assets/logo.png">
<title>@(Model.Seo?.Title ?? "Pricing, eGlobe Solutions | Hotel Management Software Pricing")</title>
<meta name="description" content="@(Model.Seo?.Description ?? "Simple, transparent pricing for the hotel technology stack eGlobe sources for you.")">
<meta name="keywords" content="@(Model.Seo?.Keywords ?? "hotel management software pricing")">
<link rel="canonical" href="@(Model.Seo?.CanonicalUrl ?? "https://www.eglobe-solutions.com/pricing.html")">
<meta property="og:type" content="website">
<meta property="og:title" content="@(Model.Seo?.Title ?? "Pricing, eGlobe Solutions")">
<meta property="og:description" content="@(Model.Seo?.Description ?? "Simple, transparent pricing for the hotel technology stack eGlobe sources for you.")">
<meta property="og:url" content="@(Model.Seo?.CanonicalUrl ?? "https://www.eglobe-solutions.com/pricing.html")">
<meta property="og:image" content="@(Model.Seo?.OgImageUrl ?? "https://www.eglobe-solutions.com/img/eGlobe-Solutions-hotel-management-services.png")">
<meta property="og:image:alt" content="eGlobe Solutions connected hotel management ecosystem">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="@(Model.Seo?.Title ?? "Pricing, eGlobe Solutions")">
<meta name="twitter:description" content="@(Model.Seo?.Description ?? "Simple, transparent pricing for the hotel technology stack eGlobe sources for you.")">
<meta name="twitter:image" content="@(Model.Seo?.OgImageUrl ?? "https://www.eglobe-solutions.com/img/eGlobe-Solutions-hotel-management-services.png")">
<link rel="stylesheet" href="~/css/style.css">
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "FAQPage",
  "mainEntity": [
  @for (var i = 0; i < Model.Faqs.Count; i++)
  {
    var f = Model.Faqs[i];
    @Html.Raw("{\"@type\":\"Question\",\"name\":" + System.Text.Json.JsonSerializer.Serialize(f.Question) + ",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":" + System.Text.Json.JsonSerializer.Serialize(f.Answer) + "}}")
    if (i < Model.Faqs.Count - 1) { @Html.Raw(",") }
  }
  ]
}
</script>
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "Organization",
      "@@id": "https://www.eglobe-solutions.com/#organization",
      "name": "eGlobe Solutions",
      "url": "https://www.eglobe-solutions.com/",
      "logo": "https://www.eglobe-solutions.com/img/logo-dark.webp",
      "sameAs": [
        "https://www.facebook.com/eglobesolution",
        "https://www.youtube.com/@@eglobesolutionspms",
        "https://www.linkedin.com/company/eglobesolutions/"
      ],
      "contactPoint": {
        "@@type": "ContactPoint",
        "telephone": "+91-9818880480",
        "contactType": "sales",
        "email": "support@@eglobe-solutions.com",
        "areaServed": "IN",
        "availableLanguage": ["English", "Hindi"]
      }
    },
    {
      "@@type": "WebSite",
      "@@id": "https://www.eglobe-solutions.com/#website",
      "url": "https://www.eglobe-solutions.com/",
      "name": "eGlobe Solutions",
      "publisher": { "@@id": "https://www.eglobe-solutions.com/#organization" }
    }
  ]
}
</script>
</head>
<body>

<div class="scroll-progress"></div>

<div class="topbar">
  <div class="topbar__inner">
    <a href="index.html" class="brand"><img class="mark" src="https://www.eglobe-solutions.com/img/logo-dark.webp" alt="eGlobe Solutions"></a>
    @await Component.InvokeAsync("TopNav")
    <div class="topbar__actions">
      <a href="https://www.eglobe-solutions.com/hms" target="_blank" rel="noopener" class="btn btn-ghost btn-sm">Log In</a>
      <a href="contact.html" class="btn btn-primary btn-sm">Talk to Sales</a>
    </div>
    <button class="topbar__burger" id="topbar-burger" aria-label="Toggle menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line class="l1" x1="3" y1="6" x2="21" y2="6"/><line class="l2" x1="3" y1="12" x2="21" y2="12"/><line class="l3" x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</div>

<header class="page-hero page-hero--compact">
  <div class="container page-hero__split">
    <h1 data-reveal><span class="accent">Simple</span> or <span class="accent-alt">sourced</span> for scale?</h1>
    <p class="lead" data-reveal>No hidden fees, no confusing tiers disguised as "value." We quote directly based on your room count and the modules you actually need.</p>
  </div>
</header>

<!-- ===================== PRICING MODELS + COMPARISON ===================== -->
<section class="section panel-white" id="models">
  <div class="container">
    <div class="section-head center" style="margin-left:auto;margin-right:auto;">
      <span class="section-kicker">Choose Your Model</span>
      <h2 data-reveal>Three ways to license eGlobe.</h2>
      <p class="lead" style="margin:16px auto 0;">Every plan is quoted by our sales team, no published figures, no guesswork. Pick the unit that matches how your property is structured.</p>
    </div>

    <div class="price-teaser" data-reveal-group>
      @foreach (var plan in Model.Plans)
      {
        <div class="price-teaser-card @(plan.IsFeatured ? "featured" : "")">
          <span class="badge-pill">@plan.BadgeText</span>
          <h4>@plan.Name</h4>
          <p class="unit">@plan.UnitDescription</p>
          <ul>
            @foreach (var f in plan.Features)
            {
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>@f.Text</li>
            }
          </ul>
          <a href="@plan.CtaUrl" class="btn @(plan.IsFeatured ? "btn-primary" : "btn-ghost") btn-block">@plan.CtaLabel</a>
        </div>
      }
    </div>

    <div class="pricing-table-wrap" data-reveal>
      <table class="pricing-table">
        <thead>
          <tr>
            <th>Module</th>
            <th>Per Room</th>
            <th>Per Property</th>
            <th>Enterprise</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var row in Model.ComparisonRows)
          {
            <tr>
              <td>@row.ModuleName</td>
              <td>@Html.Raw(CellHtml(row.PerRoomValue))</td>
              <td>@Html.Raw(CellHtml(row.PerPropertyValue))</td>
              <td>@Html.Raw(CellHtml(row.EnterpriseValue))</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ===================== FAQ ===================== -->
<section class="section section-border-top panel-white">
  <div class="container" style="max-width:820px;">
    <div class="section-head center" style="margin-left:auto;margin-right:auto;">
      <span class="section-kicker">FAQ</span>
      <h2 data-reveal>Pricing questions, answered.</h2>
    </div>
    <div class="faq-list" data-reveal-group>
      @foreach (var faq in Model.Faqs)
      {
        <div class="faq-item">
          <div class="faq-q">
            <span>@faq.Question</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
          <div class="faq-a"><p>@faq.Answer</p></div>
        </div>
      }
    </div>
  </div>
</section>

<!-- ===================== FINAL CTA ===================== -->
<section class="section-tight">
  <div class="container">
    <div class="final-cta" data-reveal="scale">
      <div class="grid-bg" style="opacity:.15"></div>
      <div style="position:relative;z-index:1;">
        <h2>Ready for a Quote Built Around Your Property?</h2>
        <p>Talk to our sales team for pricing tailored to your room count, module needs and portfolio size.</p>
        <div class="final-cta__row">
          <a href="contact.html" class="btn btn-dark">Contact Sales</a>
          <a href="index.html" class="btn btn-ghost">Back to Home</a>
        </div>
      </div>
    </div>
  </div>
</section>

@await Component.InvokeAsync("SiteFooter")

<div class="nav-dock-wrap">
  <nav class="nav-dock">
    <button class="nav-dock__burger" id="nav-dock-burger" aria-label="Toggle menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line class="l1" x1="3" y1="6" x2="21" y2="6"/><line class="l2" x1="3" y1="12" x2="21" y2="12"/><line class="l3" x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <span class="nav-dock__brand"><img src="/assets/logo.png" alt="eGlobe"></span>
    @await Component.InvokeAsync("NavDock")
    <a href="contact.html" class="nav-dock__cta">Book a Demo</a>
  </nav>
</div>

<script src="~/js/main.js"></script>
</body>
</html>

@functions {
    private static string CellHtml(string value) => value switch
    {
        "included" => "&#10003;",
        "addon" => "<span class=\"dim\">Add-on</span>",
        _ => "<span class=\"dim\">-</span>"
    };
}
